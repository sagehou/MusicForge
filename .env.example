MUSICFORGE_VERSION=latest
MUSICFORGE_PUBLIC_URL=https://musicforge.example.com
# Additional origins, e.g. https://musicforge.home.example.com,https://musicforge-alt.example.com
# The primary URL is allowed automatically.
MUSICFORGE_ALLOWED_ORIGINS=
# Set to the actual reverse proxy's IP CIDR(s), e.g. 172.20.0.2/32.
MUSICFORGE_TRUSTED_PROXIES=
# No-progress timeout for mounted source reads/encoding (1–3600 seconds).
MUSICFORGE_SOURCE_TIMEOUT_SECONDS=120
CONFIG_DIR=/srv/musicforge/config
# Source audio library; the legacy variable name also supports mixed formats.
FLAC_DIR=/srv/music/flac
OUTPUT_DIR=/srv/music/streaming
PUID=10001
PGID=10001

# Total local source scratch space in /config, shared by all conversion workers (bytes).
MUSICFORGE_STAGING_MAX_BYTES=4294967296
